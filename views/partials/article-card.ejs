<article class="article-card">
  <% if (article.image_url) { %>
    <a class="card-image-link" href="/artikel/<%= article.slug %>">
      <img class="card-image" src="<%= article.image_url %>" alt="" loading="lazy">
    </a>
  <% } else { %>
    <a class="card-art" href="/artikel/<%= article.slug %>" aria-label="Buka <%= article.title %>">
      <span class="art-node art-node-one"></span>
      <span class="art-node art-node-two"></span>
      <span class="art-line"></span>
      <span class="art-label">NETWORK / GUIDE</span>
    </a>
  <% } %>
  <div class="card-body">
    <a class="eyebrow" href="/kategori/<%= article.category_slug %>"><%= article.category_name %></a>
    <h3><a href="/artikel/<%= article.slug %>"><%= article.title %></a></h3>
    <p><%= article.summary %></p>
    <a class="text-link" href="/artikel/<%= article.slug %>">Baca panduan <span aria-hidden="true">→</span></a>
  </div>
</article>
