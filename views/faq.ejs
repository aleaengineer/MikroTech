<%- include('partials/head') %>
<section class="page-hero">
  <div class="container page-hero-inner">
    <div><span class="eyebrow">MIKROTECH / FAQ</span><h1>Pertanyaan yang sering diajukan.</h1>
      <p>Informasi singkat untuk membantu kamu belajar dan menggunakan panduan MikroTech.</p></div>
    <span class="page-hero-code">HELP_ / KNOWLEDGE</span>
  </div>
</section>
<section class="section">
  <div class="container faq-layout">
    <div class="faq-list">
      <% faqs.forEach((faq, index) => { %>
        <details class="faq-item" <%= index === 0 ? 'open' : '' %>>
          <summary><span class="faq-index"><%= String(index + 1).padStart(2, '0') %></span><span><%= faq.question %></span><span class="faq-toggle" aria-hidden="true">+</span></summary>
          <p><%= faq.answer %></p>
        </details>
      <% }) %>
    </div>
    <aside class="faq-aside">
      <span class="eyebrow">MASIH BUTUH BANTUAN?</span>
      <h2>Kami siap menerima pertanyaanmu.</h2>
      <p>Kirim pertanyaan atau masukan melalui halaman kontak MikroTech.</p>
      <a class="button button-primary" href="/kontak">Hubungi MikroTech <span aria-hidden="true">→</span></a>
    </aside>
  </div>
</section>
<%- include('partials/footer') %>
